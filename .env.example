# ---------------------------------------------------------------------------
# ENRP – Beispielkonfiguration. Kopieren nach .env und Werte eintragen.
# Niemals echte Geheimnisse in das Repository einchecken!
# ---------------------------------------------------------------------------
APP_ENV=development            # development | staging | production
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.0.0-dev

# Datenbank & Redis
DATABASE_URL=postgres://enrp:enrp@localhost:5432/enrp_dev
REDIS_URL=redis://localhost:6379
RUN_MIGRATIONS=true            # API führt beim Start ausstehende Migrationen aus

# API
API_HOST=0.0.0.0
API_PORT=4000
PUBLIC_URL=http://localhost:3000     # Öffentliche URL, unter der /api erreichbar ist (OAuth-Redirects)
DASHBOARD_URL=http://localhost:3000
TRUST_PROXY=false                    # true hinter einem Reverse Proxy (nginx, Traefik)
# Zufallswerte erzeugen: openssl rand -base64 48
BOT_API_TOKEN=
HASH_SECRET=
METRICS_TOKEN=
RELEASE_WEBHOOK_SECRET=

# Discord (Developer Portal → Anwendung)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
OWNER_DISCORD_IDS=                   # Kommagetrennt, Notfall-/Erstzugang mit Vollrechten
VERIFIED_ROLE_ID=                    # Rolle „Verifiziert“ (alternativ im Dashboard einstellbar)

# Roblox OAuth 2.0 (create.roblox.com → Credentials → OAuth 2.0 Apps)
# Redirect-URI: <PUBLIC_URL>/api/v1/verification/roblox/callback, Scopes: openid profile
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
# Optional: Weckruf für Server-Befehle über Open Cloud Messaging (create.roblox.com → Open Cloud → API Keys,
# Berechtigung universe-messaging-service:publish). Ohne diese Werte holen Server Befehle alle ~5 s ab.
ROBLOX_UNIVERSE_ID=
ROBLOX_OPEN_CLOUD_KEY=

# Bot
API_URL=http://localhost:4000        # Interne API-Adresse für Bot und Dashboard (Server-seitig)

# Produktion: Domain für den eingebauten Caddy (docker-compose.prod.yml --profile caddy)
ENRP_DOMAIN=

# Worker
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
RESTORE_TEST_DATABASE_URL=           # Optional: Scratch-DB für automatische Wiederherstellungstests
GITHUB_DEPLOY_REPO=                  # Optional: owner/repo für workflow_dispatch bei freigegebenen Releases
GITHUB_DEPLOY_WORKFLOW=deploy.yml
GITHUB_DEPLOY_TOKEN=
