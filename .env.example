# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Optional: nur nötig, wenn der Bot schon vor dem Mehr-Server-Update lief und jetzt auf mehreren Servern ist.
# Die alten /einstellungen-Änderungen werden dann diesem Server zugeordnet.
GUILD_ID=

# --- Eigenes Roblox-Spiel – Anleitung: docs/live-system.md ---
# Eure Domain, über die das Spiel mit dem Bot spricht (ohne / am Ende), z. B. https://xyz.apps.bot-hosting.cloud
PUBLIC_URL=
# Port des Bridge-Webservers. Leer lassen auf bot-hosting.net – dann wird SERVER_PORT vom Hoster genommen.
WEB_PORT=
# Mind. 32 zufällige Zeichen: verschlüsselt Schlüssel in der Datenbank. Erzeugen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Nicht mehr ändern, sonst müssen gespeicherte Schlüssel neu hinterlegt werden.
ENRP_SECRET=
# Optional: Bridge-Schlüssel direkt hier (mind. 32 Zeichen). Sonst per /spiel-admin bridge-schluessel erzeugen.
BRIDGE_SECRET=
# ID(s) des Haupt-Discords, der das ganze Spiel steuern darf (mehrere mit Komma trennen)
ROBLOX_MAIN_GUILD_IDS=
# Optional: Universe-ID (Spielstatistik, Roblox-Ban-API) – Creator Hub -> dein Spiel -> ... -> Copy Universe ID
ROBLOX_UNIVERSE_ID=
# Optional: Open-Cloud-API-Key nur für die Roblox-Ban-API (Rechte: universe.user-restriction read+write).
# Wie ein Passwort behandeln! Alternativ verschlüsselt per /spiel-admin api-key.
ROBLOX_API_KEY=
