# ─────────────────────────────────────────────────────────────────────────────
# Emden Network – Konfiguration. Kopieren nach .env und ausfüllen.
# NIEMALS echte Werte committen. Alle Werte hier sind Platzhalter.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Datenbank (docker-compose) ───────────────────────────────────────────────
# Passwort des Schema-Eigentümers (Migrationen)
POSTGRES_PASSWORD=
# Passwort der eingeschränkten App-Rolle emden_app (API + Bot)
APP_DB_PASSWORD=
# Nur für Start ohne Docker (pnpm dev:api / dev:bot / db:migrate):
DATABASE_URL=postgres://emden_owner:PASSWORT@localhost:5432/emden

# ── Öffentliche API-URL ──────────────────────────────────────────────────────
# Lokal: http://localhost:3000 – Produktion: https://api.deine-domain.de
# Daraus ergibt sich die Redirect-URI: <PUBLIC_BASE_URL>/auth/roblox/callback
PUBLIC_BASE_URL=http://localhost:3000
# Lokal ohne HTTPS: false. In Produktion zwingend true.
COOKIE_SECURE=false
# Hinter Reverse-Proxy (Caddy/Nginx): Anzahl der Proxys, z. B. 1
TRUST_PROXY=

# ── Roblox OAuth 2.0 (Creator Hub → OAuth 2.0 Apps) ──────────────────────────
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=

# ── Interne Schlüssel (je mind. 32 Zeichen, z. B. `openssl rand -hex 32`) ─────
# Für interne Dienste (z. B. späteres Dashboard) an /v1/verification/revoke und /v1/players
INTERNAL_API_TOKEN=
# Für Roblox-Spielserver; identischen Wert im Creator Hub als Secret "EmdenNetworkGameApiKey" hinterlegen
GAME_API_KEY=
# Kommagetrennte Place-IDs, die die Game-API nutzen dürfen (Produktion: Pflicht)
ALLOWED_PLACE_IDS=

# ── Discord (Developer Portal) ───────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
