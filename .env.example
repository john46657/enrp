# Zugangsdaten der Entwicklungs-Datenbank (docker-compose.yml).
# Nur für deinen eigenen Rechner – in Produktion ein langes, zufälliges Passwort verwenden.
POSTGRES_USER=enrp
POSTGRES_PASSWORD=enrp_dev_passwort
POSTGRES_DB=enrp
POSTGRES_PORT=5432

# Verbindungs-URL, die API und Worker ab Phase 1 verwenden.
DATABASE_URL=postgres://enrp:enrp_dev_passwort@localhost:5432/enrp
