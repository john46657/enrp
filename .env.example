# Emden Network – Beispielkonfiguration
# Kopiere diese Datei nach ".env" und passe die Werte an. Die .env wird NIE committet.
# Hier stehen ausschließlich Platzhalter – trage niemals echte Zugangsdaten in diese Datei ein.

# ---------------------------------------------------------------------------
# Emden Network Backend (apps/api)
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Lokal nur auf dem eigenen Rechner lauschen. In Containern/Hosting: 0.0.0.0
API_HOST=127.0.0.1
# Port der API. Viele Hoster (z. B. Railway) setzen stattdessen PORT automatisch.
API_PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Kommagetrennte Liste weiterer Browser-Ursprünge, die die API DIREKT aufrufen dürfen.
# Normalerweise leer: Das Dashboard spricht die API über seinen eigenen Server an.
# "*" ist absichtlich nicht erlaubt. In Produktion nur https://…
CORS_ORIGINS=
# Max. Anfragen pro IP und Zeitfenster (Health-Endpunkte sind ausgenommen)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Nur auf true setzen, wenn die API hinter einem vertrauenswürdigen Reverse-Proxy läuft
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Datenbank (apps/api)
# ---------------------------------------------------------------------------
# Leer lassen = lokale Entwicklungsdatenbank (PGlite) im Ordner apps/api/.data – nichts zu installieren.
# Für echtes PostgreSQL (in Produktion Pflicht), Beispielformat:
#   DATABASE_URL=postgres://BENUTZER:PASSWORT@localhost:5432/emden_network
DATABASE_URL=

# ---------------------------------------------------------------------------
# Anmeldung mit Discord (apps/api)
# ---------------------------------------------------------------------------
# Adresse des Control Centers im Browser (ohne Pfad). Lokal genau so lassen:
DASHBOARD_PUBLIC_URL=http://127.0.0.1:3000
# Aus dem Discord Developer Portal → deine Anwendung → OAuth2. Beide leer = Anmeldung nicht eingerichtet.
# Das Client Secret ist GEHEIM: nur hier in der .env eintragen – niemals in einen Chat oder ins Repository.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Ersteinrichtung: deine eigene Discord-Benutzer-ID (17–20 Ziffern). Solange es noch keinen Owner gibt,
# wird diese Person beim Start des Backends Owner. Gibt es schon einen, wird der Wert ignoriert.
OWNER_DISCORD_USER_ID=
# Sitzungen enden nach so vielen Minuten ohne Aktivität bzw. spätestens nach so vielen Stunden.
SESSION_IDLE_MINUTES=240
SESSION_MAX_HOURS=24
# Audit-Log-Einträge werden nach so vielen Tagen automatisch gelöscht (mindestens 30).
AUDIT_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# Emden Network Control Center (apps/dashboard)
# ---------------------------------------------------------------------------
# Adresse, unter der der Dashboard-Server das Backend erreicht (nur serverseitig genutzt)
API_INTERNAL_URL=http://127.0.0.1:4000
# Optional: Next.js-Telemetrie abschalten
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Geplant (noch NICHT verwendet)
# ---------------------------------------------------------------------------
# Phase 4: DISCORD_TOKEN=<aus dem Discord Developer Portal>
