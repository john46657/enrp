# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Optional: nur nötig, wenn der Bot schon vor dem Mehr-Server-Update lief und jetzt auf mehreren Servern ist.
# Die alten /einstellungen-Änderungen werden dann diesem Server zugeordnet.
GUILD_ID=

# Web-Dashboard (optional). Ohne diese Werte startet nur der Bot.
# Öffentliche Adresse, unter der das Dashboard erreichbar ist (ohne / am Ende):
DASHBOARD_URL=https://2pgwy073wo.apps.bot-hosting.cloud
# Developer Portal → OAuth2 → Client Secret. Redirect dort eintragen: DASHBOARD_URL + /auth/callback
DISCORD_CLIENT_SECRET=
# Zufälliger langer Text zum Signieren der Login-Cookies (leer = Bot-Token wird verwendet)
DASHBOARD_SECRET=
# Port: bot-hosting/Pterodactyl setzen SERVER_PORT automatisch. Nur lokal nötig:
# DASHBOARD_PORT=3000
