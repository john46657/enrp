# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Optional: nur nötig, wenn der Bot schon vor dem Mehr-Server-Update lief und jetzt auf mehreren Servern ist.
# Die alten /einstellungen-Änderungen werden dann diesem Server zugeordnet.
GUILD_ID=

# Optional: Web-Teil (Browser-Formular für Bewerbungen und Dashboard fürs Team).
# Öffentliche Adresse, unter der der Bot erreichbar ist – ohne WEB_URL bleibt der Web-Teil aus.
WEB_URL=
# Port, auf dem der Bot lauscht (bei Bot-Hostern der zugewiesene Port; Standard 8080)
WEB_PORT=
# Geheimnis für die signierten Links. Leer = der Bot erzeugt eins und speichert es in data/db.json.
WEB_SECRET=
