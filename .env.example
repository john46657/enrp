# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Optional: nur nötig, wenn der Bot schon vor dem Mehr-Server-Update lief und jetzt auf mehreren Servern ist.
# Die alten /einstellungen-Änderungen werden dann diesem Server zugeordnet.
GUILD_ID=

# ---------- Web-Dashboard (optional, siehe docs/dashboard.md) ----------
# Öffentliche Adresse, unter der das Dashboard erreichbar ist (ohne / am Ende)
DASHBOARD_URL=
# Port, auf dem der Bot das Dashboard bereitstellt (der Reverse-Proxy leitet die Domain hierhin)
DASHBOARD_PORT=3000
# 127.0.0.1 = nur über den Reverse-Proxy erreichbar (empfohlen). 0.0.0.0 = direkt von außen.
DASHBOARD_HOST=127.0.0.1
# Developer Portal → deine Anwendung → OAuth2: Client ID und Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Zufälliger Schlüssel für die Anmelde-Cookies, mind. 32 Zeichen. Erzeugen z. B. mit:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SECRET=

# ---------- Bot-Admins (optional) ----------
# Discord-IDs (Rechtsklick → ID kopieren), durch Komma getrennt. Diese Personen haben auf JEDEM Server, auf dem der
# Bot ist, vollen Zugriff auf Bewerbungen, Tickets und Einstellungen – im Dashboard auch ohne Mitglied zu sein.
# Nur vertrauenswürdige Personen eintragen. Änderungen gelten nach einem Neustart des Bots.
BOT_ADMINS=
