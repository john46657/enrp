# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Optional: nur nötig, wenn der Bot schon vor dem Mehr-Server-Update lief und jetzt auf mehreren Servern ist.
# Die alten /einstellungen-Änderungen werden dann diesem Server zugeordnet.
GUILD_ID=

# Optional: Web-Dashboard für Bewerbungen und Panels (Login mit Discord). Leer lassen = aus.
# Client Secret: Developer Portal -> OAuth2 -> Client Secret (Reset Secret). Niemals teilen!
DISCORD_CLIENT_SECRET=
# Adresse, unter der das Dashboard erreichbar ist, z. B. http://123.45.67.89:8080 oder https://dashboard.example.de
# Unter OAuth2 -> Redirects muss genau diese Adresse + /callback eingetragen sein (z. B. http://123.45.67.89:8080/callback).
DASHBOARD_URL=
# Port des Webservers. Auf Bot-Hostern den Port deines Servers eintragen (oft unter "Netzwerk" / "Allocation").
DASHBOARD_PORT=
