{
  "name": "@enrp/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@enrp/config": "workspace:*",
    "@enrp/core": "workspace:*",
    "@enrp/database": "workspace:*",
    "@enrp/integrations": "workspace:*",
    "@enrp/permissions": "workspace:*",
    "@enrp/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.11.1",
    "openapi-types": "^12.1.3",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
