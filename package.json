{
  "name": "emden-network",
  "version": "0.1.0",
  "private": true,
  "description": "Emden Network – Roblox-Servermanagement-Plattform mit Control Center, Backend, Discord-Bot und TikTok-LIVE-Modul",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev -w @emden/api",
    "dev:dashboard": "npm run dev -w @emden/dashboard",
    "start:api": "npm run start -w @emden/api",
    "start:dashboard": "npm run start -w @emden/dashboard",
    "db:migrate": "npm run db:migrate -w @emden/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "legacy:bot:install": "npm ci --prefix legacy/discord-bot",
    "legacy:bot:start": "npm start --prefix legacy/discord-bot"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
