{
  "name": "enrp",
  "private": true,
  "description": "GermanRP-Plattform: Discord-Bot, Fastify-API, Worker, Next.js-Dashboard und Roblox-Integration",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @enrp/api --filter @enrp/worker --filter @enrp/bot --filter @enrp/dashboard build",
    "typecheck": "pnpm -r --filter=!@enrp/dashboard typecheck && pnpm --filter @enrp/dashboard typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "pnpm --filter @enrp/database generate",
    "db:migrate": "pnpm --filter @enrp/database migrate",
    "db:seed": "pnpm --filter @enrp/database seed",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "pg": "^8.16.3",
    "prettier": "3.6.2",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.31",
      "@fastify/static": "^10.1.7"
    }
  }
}
